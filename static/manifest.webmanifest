{
  "name": "DiresQ — disaster response tracker",
  "short_name": "DiresQ",
  "description": "Every disaster app tells you where the disaster is. DiresQ tracks the people going into it.",

  "start_url": "/board",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",

  "background_color": "#1e1e2e",
  "theme_color": "#1e1e2e",

  "icons": [
    {
      "src": "/static/images/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/images/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/images/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/static/images/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "shortcuts": [
    {
      "name": "Check in",
      "short_name": "Check in",
      "description": "Reset your timer and update your last known position",
      "url": "/board?checkin=1"
    },
    {
      "name": "File a report",
      "short_name": "Report",
      "description": "Something is happening and somebody needs to know",
      "url": "/report/new"
    }
  ],

  "categories": ["utilities", "productivity"],
  "lang": "en"
}
