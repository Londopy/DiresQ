---
// Movement, kept quiet.
//
// A documentation site about a disaster tool shouldn't be doing somersaults,
// so this is deliberately restrained: one small orb that trails the cursor,
// content that rises as you reach it, and a fade between pages. Everything
// switches off completely under prefers-reduced-motion, and nothing here
// affects layout — it can't push text around while you read.
//
// Same approach as the orb on londopy.github.io, retuned for this palette:
// blue and lavender rather than green, because green already means "on scene"
// everywhere else in this project.
---

<div id="orb" aria-hidden="true"></div>

<style is:global>
  /* The bright core. Small and sharp — a big faint gradient reads as a
     smudge on a dark background, which is the mistake the first version of
     this made. mix-blend-mode: screen is what makes it glow rather than sit
     on top like a sticker. */
  /* The one number. The script measures the element rather than carrying its
     own copy, so changing this can't leave the orb centred on the wrong
     point.

     There was a second, much wider "wash" layer here. It was the thing that
     made the page look smudged rather than lit — a big soft gradient reads as
     a stain on a dark background no matter how faint you make it. One small
     bright orb is the whole effect. */
  :root {
    --orb-size: 14px;
  }

  #orb {
    position: fixed;
    top: 0;
    left: 0;
    width: var(--orb-size);
    height: var(--orb-size);
    border-radius: 50%;
    pointer-events: none;
    /* Above everything. The page content sits in its own stacking context
       and would otherwise cover this. */
    z-index: 9998;
    opacity: 0;
    transition: opacity 350ms ease;
    will-change: transform;
    mix-blend-mode: screen;
    background: radial-gradient(
      circle,
      rgba(180, 190, 254, 0.75) 0%,
      rgba(137, 180, 250, 0.35) 35%,
      rgba(137, 180, 250, 0) 70%
    );
    box-shadow:
      0 0 16px 5px rgba(137, 180, 250, 0.18),
      0 0 5px 1px rgba(203, 214, 244, 0.30);
  }

  header, main, footer { position: relative; z-index: 1; }

  /* No orb on anything you touch rather than point at. */
  @media (hover: none), (pointer: coarse) {
    #orb { display: none; }
  }

  /* Sections start slightly low and settle as they come into view. `.lift`
     is only ever added by JS, so with JS off everything is simply visible. */
  .lift {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 620ms cubic-bezier(0.22, 1, 0.36, 1),
                transform 620ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .lift.seen { opacity: 1; transform: none; }

  @keyframes page-in {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: none; }
  }

  main { animation: page-in 420ms cubic-bezier(0.22, 1, 0.36, 1) both; }

  /* Nav underline grows from the left instead of appearing. */
  nav a { position: relative; padding-bottom: 2px; }

  nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    height: 1px;
    width: 100%;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms ease;
  }

  nav a:hover::after,
  nav a[aria-current="page"]::after { transform: scaleX(1); }

  .cards a {
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
                border-left-color 220ms ease,
                background 220ms ease;
  }

  .cards a:hover { transform: translateY(-3px); }

  /* Somebody who has asked their system to stop moving things gets a still
     page. Not a slower one — a still one. */
  @media (prefers-reduced-motion: reduce) {
    #orb { display: none; }
    .lift, .lift.seen { opacity: 1; transform: none; transition: none; }
    main { animation: none; }
    nav a::after { transition: none; }
    .cards a:hover { transform: none; }
  }
</style>

<script>
  // Astro swaps the DOM on navigation, so this has to be re-runnable. The
  // loop is cancelled and restarted rather than left running twice.
  let running = 0;

  function ambience() {
    cancelAnimationFrame(running);

    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;

    const orb = document.getElementById("orb");

    if (orb && fine && !still) {
      // Measured, not hardcoded, so changing --orb-size in the CSS above is
      // the only edit needed. A stale constant here would quietly offset the
      // orb from the actual cursor.
      const half = () => orb.offsetWidth / 2;
      let tx = innerWidth / 2, ty = innerHeight / 2;
      let ox = tx, oy = ty;

      addEventListener("pointermove", (e) => {
        tx = e.clientX;
        ty = e.clientY;
        orb.style.opacity = "1";
      }, { passive: true });

      // Fade out when the pointer leaves rather than stranding it in a corner.
      document.addEventListener("mouseleave", () => {
        orb.style.opacity = "0";
      });

      // Eased towards the target in a rAF loop. Writing the transform inside
      // the pointermove handler instead would mean several writes per frame
      // for no visible gain — pointer events fire faster than the screen
      // refreshes.
      const step = () => {
        ox += (tx - ox) * 0.18;
        oy += (ty - oy) * 0.18;
        const h = half();
        orb.style.transform = `translate(${ox - h}px, ${oy - h}px)`;
        running = requestAnimationFrame(step);
      };
      step();
    } else {
      orb?.remove();
    }

    if (still) return;

    // Reveal on scroll. IntersectionObserver rather than a scroll handler, so
    // the browser does the work off the main thread.
    const targets = document.querySelectorAll(
      "article > h2, article > h3, article > table, article > pre, .cards a");
    if (!("IntersectionObserver" in window) || !targets.length) return;

    const watcher = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add("seen");
        watcher.unobserve(entry.target);   // one-shot; re-animating is annoying
      }
    }, { rootMargin: "0px 0px -8% 0px", threshold: 0.05 });

    targets.forEach((el) => {
      el.classList.add("lift");
      watcher.observe(el);
    });
  }

  ambience();
  document.addEventListener("astro:page-load", ambience);
</script>
