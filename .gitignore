# Python
__pycache__/
*.py[cod]
venv/
.venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/

# Database
*.db
*.sqlite
*.sqlite3

# Secrets
.env
*.key

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Sublime Text
# Per-user window state: open tabs, unsaved buffers, find history.
*.sublime-workspace
# Shared project settings.
*.sublime-project
# SFTP plugin config. Stores host passwords and keys in plaintext.
sftp-config.json
sftp-config-alt*.json
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache

# Logs
*.log

# Astro site under site/
site/node_modules/
site/dist/
site/.astro/

# The doc pages are copied out of ../docs at build time by sync-docs.mjs.
# Committing them would give every page two copies, and someone would edit
# the wrong one.
site/src/pages/*.md
