# Copy to .env and fill in. .env is gitignored and never gets committed.
#
#   copy .env.example .env
#
# Real environment variables override anything set here.


# Signs session cookies. Generate your OWN, do not share it or copy a
# teammate's: you each run a separate server against a separate database, so
# a shared value buys nothing and doubles the blast radius if it leaks.
#
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Without it a new key is generated at every boot, which logs you out on
# every reload.
DIRESQ_SECRET_KEY=

# Stay signed in as this user without logging in. Development only, and it
# is a full auth bypass: anyone who can set it is signed in as anyone.
# Leave blank to get the real login flow.
DIRESQ_DEV_USER=

# SQLite file. Relative paths resolve against the working directory.
DIRESQ_DB=diresq.db

# Set to 1 when the site is served over HTTPS. Marks session cookies Secure
# and sends HSTS. Leave unset on localhost or you will not stay signed in.
DIRESQ_HTTPS_ONLY=

# Set to 1 on a public demo. Puts a banner on every page saying nothing here
# is real and the data resets.
DIRESQ_DEMO=
